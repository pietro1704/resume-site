{
  "name": "resume-site",
  "version": "1.0.0",
  "private": false,
  "description": "Single-source-of-truth resume site: one JSON powers a bilingual web portfolio + multiple ATS-friendly PDF templates.",
  "keywords": [
    "resume",
    "cv",
    "portfolio",
    "next.js",
    "puppeteer",
    "pdf-generation",
    "ats-friendly",
    "bilingual"
  ],
  "author": "Pietro Pugliesi <pietroruypugliesi@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pietro1704/resume-site.git"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fetch-private-data.js",
    "build": "npm run pdf && next build",
    "build-all": "npm run pdf && next build",
    "start": "next start",
    "pdf": "node scripts/generate-resumes.js",
    "clean": "rm -rf .next out data/private",
    "deploy": "npm run clean && npm run build"
  },
  "dependencies": {
    "next": "14.2.32",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "4.12.0"
  },
  "devDependencies": {
    "archiver": "5.3.1",
    "autoprefixer": "10.4.16",
    "postcss": "8.4.31",
    "puppeteer": "24.9.0",
    "tailwindcss": "3.3.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
